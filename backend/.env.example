DB_URL=jdbc:postgresql://localhost:5432/fuelytics
DB_USER=postgres
DB_PASS=postgres
FRONTEND_URL=http://localhost:5173
JWT_SECRET=cambia-esta-clave-por-al-menos-32-caracteres-seguros
JWT_EXPIRATION_MS=3600000
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MS=60000
FORWARD_HEADERS_STRATEGY=native
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Identificador OAuth de tipo Aplicación web en Google Cloud. Vacío desactiva Google.
# No se necesita client secret para Google Identity Services con validación del ID token.
GOOGLE_CLIENT_ID=

# SMTP autenticado con STARTTLS: sustituye los ejemplos por los datos de tu proveedor.
# Spring no carga este archivo automáticamente; define las variables en el entorno del backend.
# Activa el envío con true solo tras configurar las credenciales y disponer de acceso SMTP saliente.
MAIL_ENABLED=false
MAIL_HOST=smtp.proveedor.example
MAIL_PORT=587
# Usuario SMTP: puede ser un correo o un identificador proporcionado por el proveedor.
MAIL_USERNAME=usuario-smtp-del-proveedor
# Contraseña SMTP o específica de aplicación, según el proveedor. No guardes secretos reales aquí.
MAIL_PASSWORD=credencial-smtp-del-proveedor
# Dirección de remitente autorizada; puede ser diferente del usuario de autenticación.
MAIL_FROM=notificaciones@tu-dominio.com
MAIL_FROM_NAME=Fuelytics
# URL del frontend para los enlaces de los correos; en producción, usa su URL pública.
MAIL_FRONTEND_URL=http://localhost:5173
